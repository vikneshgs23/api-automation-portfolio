        {
          "name": "CreateBooking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"bookingid is returned\", function () {\r\n    pm.expect(pm.response.json()).to.have.property(\"bookingid\");\r\n    pm.expect(pm.response.json().bookingid).to.be.a(\"number\");\r\n});\r\n\r\npm.test(\"Response data matches the request\", function () {\r\n    const sent = JSON.parse(pm.request.body.raw);\r\n    const booking = pm.response.json().booking;\r\n    pm.expect(booking.firstname).to.eql(sent.firstname);\r\n    pm.expect(booking.lastname).to.eql(sent.lastname);\r\n    pm.expect(booking.totalprice).to.eql(sent.totalprice);\r\n    pm.expect(booking.depositpaid).to.eql(sent.depositpaid);\r\n    pm.expect(booking.bookingdates.checkin).to.eql(sent.bookingdates.checkin);\r\n    pm.expect(booking.bookingdates.checkout).to.eql(sent.bookingdates.checkout);\r\n    pm.expect(booking.additionalneeds).to.eql(sent.additionalneeds);\r\n});\r\n\r\n// Save the ID for the later requests\r\npm.environment.set(\"bookingId\", pm.response.json().bookingid);"
                ]
              }
            }
          ],
